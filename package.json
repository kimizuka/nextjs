{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:next dev:css",
    "dev:next": "next dev --turbopack",
    "dev:css": "hcm 'src/**/*.module.css' --watch",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check --write ./src",
    "update": "ncu -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@storybook/nextjs": "^9.1.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-css-modules": "^4.0.0",
    "npm-check-updates": "^18.0.1",
    "npm-run-all": "^4.1.5",
    "storybook": "^9.1.3",
    "typescript": "^5"
  }
}
